{
  "manifest_version": 3,
  "name": "Doomed Scroller",
  "version": "0.1.0",
  "description": "Tracks time wasted on YouTube, Reddit and LinkedIn, shows philosophy to read instead, warns, then blocks.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://philosophyapi.pythonanywhere.com/*",
    "https://www.stoic-quotes.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Doomed Scroller",
    "default_popup": "popup.html"
  }
}
